# Sui RPC endpoint. Use the network where Veridis is published.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# The published Veridis package id (0x...). LEAVE AS 0x0 until you run
# `sui client publish` — the indexer will simply find no events until then.
VERIDIS_PACKAGE_ID=0x0

# Polling cadence in milliseconds.
POLL_INTERVAL_MS=4000

# Read-API port.
PORT=8787

# Where the JSON datastore lives (created automatically).
DATA_FILE=./data/veridis-index.json
